# Địa chỉ gốc của API backend (FastAPI)
VITE_API_URL=http://127.0.0.1:8000

# Mọi biến `VITE_*` đều được Vite nội thẳng vào bundle gửi cho trình duyệt —
# bấm F12 là thấy hết. Không có bí mật nào đặt ở đây được "giấu".
#
# Key MapTiler vì thế không phải bí mật, mà là một tài nguyên có chi phí: ai
# cũng đọc được, và dùng vào tài khoản của bạn thì họ đắp đáy bản đồ tính phí
# của bạn. Cách chặn duy nhất là phía nhà cung cấp: khoá mới → giới hạn theo
# danh sách domain (HTTP referrers) + hạn mức/quota thấp.
#
# Còn trống thì MapView dùng style Liberty miễn phí từ OpenFreeMap — chạy được
# ngay, không cần key.
VITE_MAPTILER_KEY=
